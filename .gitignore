# Engine source, unpacked from the shipped gen1recomp.exe for reference only.
# Not ours to redistribute -- same reason this repo ships no ROM and no mods.
engine-src/

# Launcher scripts hardcode the path to *your* copy of the game, so they are
# per-machine by definition.  Regenerate them with `pokepack instance`.
launchers/

# Generated by `pokepack feed` and by CI -- the gallery publishes it, the repo
# does not carry it.
packs.json
status.json

# Verified mod zips waiting to be imported. Other people's work; never ours to
# commit.
downloads/

# Deleted packs. The tool never erases anything -- it moves it here -- but a
# thing you deleted is the last thing that should come back in a commit.
.trash/

# packs/ is deliberately NOT ignored.
#
# It was, briefly, to stop a careless `git add -A` sweeping half-finished
# exports into the repo. That protected the maintainer from one bad habit and
# broke every contributor: this repo exists to collect .pokepack files, and
# CONTRIBUTING tells people to commit one, so ignoring them meant `git add`
# silently did nothing and the pack never reached the pull request.
#
# Add your pack by name -- `git add packs/your-pack.pokepack` -- rather than
# staging everything, and drafts you are still working on stay out on their own.

node_modules/
*.log
.cache/
.test-tmp*/

# Local-only: which game folder and executable this machine uses.
config.json
