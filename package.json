  },
  "keywords": [
    "gen1recomp",
    "modpack",
    "pokemon",
    "love2d",
    "modding"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
