{
  "name": "@moonfall-man/pokepack",
  "version": "0.2.0",
  "description": "Modpack recipes for gen1recomp: pinned mods, tested settings, no hosting.",
  "type": "module",
  "bin": {
    "pokepack": "./bin/pokepack.js"
  },
  "scripts": {
    "start": "node bin/pokepack.js ui",
    "build:exe": "node build/exe.mjs",
    "test": "node test/run.js",
    "hub": "node bin/pokepack.js ui",
    "feed": "node bin/pokepack.js feed packs --out packs.json"
  },
  "keywords": [
    "gen1recomp",
    "modpack",
    "pokemon",
    "love2d",
    "modding"
  ],
  "engines": {
    "node": ">=18"
  },
  "//devDependencies": "Build-time only. pokepack runs with nothing installed; these package it into dist/pokepack.exe.",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  },
  "license": "MIT",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
